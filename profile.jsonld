    {
      "@type": "Person",
      "@id": "https://hangyu8123.github.io/#person",
      "name": "Hang Yu",
      "givenName": "Hang",
      "familyName": "Yu",
      "alternateName": [
        "余航",
        "Hang Yu (余航)",
        "H. Yu"
      ],
      "url": "https://hangyu8123.github.io/",
      "image": "https://hangyu8123.github.io/assets/img/profile.jpg",
      "description": "I am a Ph.D. candidate in Computer Science at Tufts University, advised by Dr. Elaine Short in the Assistive Agent and Behavior Learning lab. My work focus on Human-Robot Interaction, Robot Learning, VLAs, and Agentic Robotics. Most of my datasets are open-sourced and were collected in public spaces with real-world, non-expert users. Right now I am a research intern at ABB Robotics, working on building new VLA models for bimanual manipulation and exploring agentic robotics for industrial robotics.",
      "jobTitle": "Ph.D. Candidate in Computer Science",
